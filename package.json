    "generate:gradient-thumbnails": "node generate-gradient-thumbnails.js",
    "add:video": "node add-video-auto.js",
    "add:photo": "node add-photo-auto.js",
    "add:player": "node add-player-auto.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
